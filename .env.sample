# Copy to .env and fill in.

# Your account's static domain, e.g. example-name.ngrok-free.app (dashboard.ngrok.com > Domains)
NGROK_DOMAIN=
# Bearer token Netomi sends to the MCP server. Setup prints one to use if this is empty.
MCP_BEARER_TOKEN=

NETOMI_AUTH_URL=your-token-url
NETOMI_CHAT_URL=your-chat-url
NETOMI_INTEGRATION=NETOMI_WEB_WIDGET  
NETOMI_CHANNEL_REF_ID=your-channel-ref-id
NETOMI_VIRTUAL_AGENT_ID=your-virtual-agent-id
